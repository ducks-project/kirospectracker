{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "noEmit": false,
    "outDir": "out",
    "rootDir": ".",
    "sourceMap": true
  },
  "include": ["test/**/*.ts", "src/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "out",
    "src/webview",
    "test/unit",
    "test/property",
    "test/runTest.ts"
  ]
}
