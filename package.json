{
  "name": "kirospectracker",
  "displayName": "Kiro Spec Tracker",
  "description": "Track the progress of your Kiro specs across the IDE: explorer badges, a dashboard, and per-spec status.",
  "version": "0.12.0",
  "publisher": "ducks-project",
  "license": "MIT",
  "author": "ducks-project",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "kiro",
    "spec",
    "spec-driven",
    "tasks",
    "progress",
    "dashboard"
  ],
  "main": "./dist/node/extension.js",
  "browser": "./dist/browser/extension.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/ducks-project/kirospectracker.git"
  },
  "bugs": {
    "url": "https://github.com/ducks-project/kirospectracker/issues"
  },
  "homepage": "https://github.com/ducks-project/kirospectracker#readme",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "kirospectracker.openDocument",
        "title": "Kiro Spec Tracker: Open Spec Document"
      },
      {
        "command": "kirospectracker.refresh",
        "title": "Kiro Spec Tracker: Refresh Specs",
        "icon": "$(refresh)"
      },
      {
        "command": "kirospectracker.runTasks",
        "title": "Kiro Spec Tracker: Run Spec Tasks"
      },
      {
        "command": "kirospectracker.toggleLayout",
        "title": "Kiro Spec Tracker: Toggle Dashboard Layout",
        "icon": "$(layout)"
      },
      {
        "command": "kirospectracker.tree.openRequirements",
        "title": "Open Requirements",
        "icon": "$(book)"
      },
      {
        "command": "kirospectracker.tree.openBugfix",
        "title": "Open Bugfix",
        "icon": "$(bug)"
      },
      {
        "command": "kirospectracker.tree.openDesign",
        "title": "Open Design",
        "icon": "$(symbol-structure)"
      },
      {
        "command": "kirospectracker.tree.openTasks",
        "title": "Open Tasks",
        "icon": "$(checklist)"
      },
      {
        "command": "kirospectracker.tree.openNotes",
        "title": "Open Notes",
        "icon": "$(note)"
      },
      {
        "command": "kirospectracker.tree.syncFiles",
        "title": "Sync Files",
        "icon": "$(sync)"
      },
      {
        "command": "kirospectracker.tree.runRequired",
        "title": "Run Required Tasks",
        "icon": "$(play)"
      },
      {
        "command": "kirospectracker.tree.runRequiredAndOptional",
        "title": "Run Required and Optional Tasks",
        "icon": "$(run-all)"
      },
      {
        "command": "kirospectracker.resetHiddenSpecs",
        "title": "Kiro Spec Tracker: Reset Hidden Specs"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "kirospectracker.openDocument",
          "when": "false"
        },
        {
          "command": "kirospectracker.tree.openRequirements",
          "when": "false"
        },
        {
          "command": "kirospectracker.tree.openBugfix",
          "when": "false"
        },
        {
          "command": "kirospectracker.tree.openDesign",
          "when": "false"
        },
        {
          "command": "kirospectracker.tree.openTasks",
          "when": "false"
        },
        {
          "command": "kirospectracker.tree.openNotes",
          "when": "false"
        },
        {
          "command": "kirospectracker.tree.syncFiles",
          "when": "false"
        },
        {
          "command": "kirospectracker.tree.runRequired",
          "when": "false"
        },
        {
          "command": "kirospectracker.tree.runRequiredAndOptional",
          "when": "false"
        }
      ],
      "explorer/context": [
        {
          "command": "kirospectracker.runTasks",
          "when": "explorerResourceIsFolder && resourcePath =~ /.*[\\\\/]\\.kiro[\\\\/]specs[\\\\/][^\\\\/]+$/",
          "group": "kirospectracker@1"
        }
      ],
      "view/title": [
        {
          "command": "kirospectracker.refresh",
          "when": "view == kirospectracker.dashboard",
          "group": "navigation"
        },
        {
          "command": "kirospectracker.toggleLayout",
          "when": "view == kirospectracker.dashboard",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "kirospectracker.tree.openRequirements",
          "when": "view == kirospectracker.tree && viewItem =~ /(^| )doc-requirements( |$)/",
          "group": "navigation@1"
        },
        {
          "command": "kirospectracker.tree.openDesign",
          "when": "view == kirospectracker.tree && viewItem =~ /(^| )doc-design( |$)/",
          "group": "navigation@2"
        },
        {
          "command": "kirospectracker.tree.openTasks",
          "when": "view == kirospectracker.tree && viewItem =~ /(^| )doc-tasks( |$)/",
          "group": "navigation@3"
        },
        {
          "command": "kirospectracker.tree.openNotes",
          "when": "view == kirospectracker.tree && viewItem =~ /(^| )doc-notes( |$)/",
          "group": "navigation@4"
        },
        {
          "command": "kirospectracker.tree.openBugfix",
          "when": "view == kirospectracker.tree && viewItem =~ /(^| )doc-bugfix( |$)/",
          "group": "navigation@5"
        },
        {
          "command": "kirospectracker.tree.syncFiles",
          "when": "view == kirospectracker.tree && viewItem =~ /(^| )agent-sync( |$)/",
          "group": "run@1"
        },
        {
          "command": "kirospectracker.tree.runRequired",
          "when": "view == kirospectracker.tree && viewItem =~ /(^| )agent-run-required( |$)/",
          "group": "run@2"
        },
        {
          "command": "kirospectracker.tree.runRequiredAndOptional",
          "when": "view == kirospectracker.tree && viewItem =~ /(^| )agent-run-optional( |$)/",
          "group": "run@3"
        }
      ]
    },
    "configuration": {
      "title": "Kiro Spec Tracker",
      "properties": {
        "kirospectracker.agentIntegration.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Enable the best-effort agent integration driving the Sync Files and Run tasks actions through the editor's chat agent (Kiro). The integration relies on non-official, unstable editor commands and is in beta; when disabled, those actions degrade to opening `tasks.md` and offering a consented, ready-to-paste prompt."
        },
        "kirospectracker.hideSpecs.mode": {
          "type": "string",
          "enum": [
            "off",
            "searchAndQuickOpen",
            "everywhere"
          ],
          "default": "off",
          "enumDescriptions": [
            "Never hide specs and never write to the exclusion settings.",
            "Hide the selected specs from Search and Quick Open only, by writing to `search.exclude` in the workspace folder settings. The Explorer is unchanged.",
            "Hide the selected specs from the Explorer, Search and Quick Open, by writing to `files.exclude` in the workspace folder settings."
          ],
          "markdownDescription": "Choose where specs whose status is selected in `#kirospectracker.hideSpecs.statuses#` are hidden. The extension writes one glob per hidden spec (`**/.kiro/specs/<name>/**`) to `search.exclude` or `files.exclude` in the settings of the workspace folder (`.vscode/settings.json`). Entries you already have are never changed or removed; switching back to `off` removes only the entries added by the extension. The Kiro agent's file and text search tools also honor these settings, so they will no longer find hidden specs. VS Code also drops hidden files from the Quick Open history. See the configuration guide for details."
        },
        "kirospectracker.hideSpecs.statuses": {
          "type": "object",
          "properties": {
            "Malformed": {
              "type": "boolean",
              "default": false,
              "description": "Hide specs whose tasks.md is missing or that lack a required document."
            },
            "NotStarted": {
              "type": "boolean",
              "default": false,
              "description": "Hide specs where no task is done yet."
            },
            "InProgress": {
              "type": "boolean",
              "default": false,
              "description": "Hide specs with some tasks done but required tasks still open."
            },
            "Completed": {
              "type": "boolean",
              "default": true,
              "description": "Hide specs whose required tasks are all done."
            },
            "FullyCompleted": {
              "type": "boolean",
              "default": true,
              "description": "Hide specs whose required and optional tasks are all done."
            }
          },
          "additionalProperties": false,
          "default": {
            "Malformed": false,
            "NotStarted": false,
            "InProgress": false,
            "Completed": true,
            "FullyCompleted": true
          },
          "markdownDescription": "Statuses whose specs are hidden when `#kirospectracker.hideSpecs.mode#` is not `off`. Tick one box per status."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "kirospectracker",
          "title": "Kiro Spec Tracker",
          "icon": "media/activitybar-icon.svg"
        }
      ]
    },
    "views": {
      "kirospectracker": [
        {
          "id": "kirospectracker.dashboard",
          "name": "Specs Dashboard",
          "type": "webview",
          "icon": "media/view-dashboard.svg"
        },
        {
          "id": "kirospectracker.tree",
          "name": "Specs by Status",
          "icon": "media/view-tree.svg"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc --noEmit && tsc --noEmit -p tsconfig.webview.json",
    "build": "node esbuild.mjs",
    "build:dev": "node esbuild.mjs --dev",
    "build:prod": "node esbuild.mjs --prod",
    "watch": "node esbuild.mjs --watch",
    "build:browser": "node esbuild.mjs --browser",
    "lint": "eslint --no-error-on-unmatched-pattern \"src/**/*.ts\" \"test/**/*.ts\" \"benchmark/**/*.ts\"",
    "format": "prettier --write \"**/*.{ts,mjs,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,mjs,json,md,yml,yaml}\"",
    "test:unit": "mocha",
    "test:property": "mocha --spec \"test/property/**/*.spec.ts\"",
    "coverage:core": "c8 --config .c8rc.json mocha",
    "coverage:adapters": "c8 --config .c8rc.adapters.json mocha",
    "coverage": "npm run coverage:core && npm run coverage:adapters",
    "test": "npm run coverage",
    "compile:test": "tsc -p tsconfig.test.json",
    "pretest:integration": "npm run compile:test",
    "test:integration": "node --loader ts-node/esm --no-warnings ./test/runTest.ts",
    "bench": "node --loader ts-node/esm --no-warnings ./benchmark/parse.bench.ts",
    "bench:update": "node --loader ts-node/esm --no-warnings ./benchmark/incremental-update.bench.ts",
    "package": "vsce package",
    "publish": "ovsx publish"
  },
  "overrides": {
    "glob": "14.0.4",
    "minimatch": "11.0.5"
  },
  "devDependencies": {
    "@types/chai": "5.0.1",
    "@types/mocha": "10.0.9",
    "@types/node": "20.17.6",
    "@types/vscode": "1.85.0",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "@vscode/test-electron": "2.4.1",
    "@vscode/vsce": "4.1.0",
    "c8": "12.0.0",
    "chai": "5.1.2",
    "esbuild": "0.28.2",
    "eslint": "8.57.1",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-import": "2.31.0",
    "fast-check": "3.23.1",
    "glob": "14.0.4",
    "lefthook": "1.8.2",
    "mitata": "1.0.20",
    "mocha": "12.0.3",
    "ovsx": "1.3.0",
    "prettier": "3.3.3",
    "ts-node": "10.9.2",
    "typescript": "5.6.3"
  }
}
