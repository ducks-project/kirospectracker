{
  "name": "kirospectracker",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "0.13.1",
  "publisher": "ducks-project",
  "license": "MIT",
  "author": "ducks-project",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "kiro",
    "spec",
    "spec-driven",
    "tasks",
    "progress",
    "dashboard"
  ],
  "main": "./dist/node/extension.js",
  "browser": "./dist/browser/extension.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/ducks-project/kirospectracker.git"
  },
  "bugs": {
    "url": "https://github.com/ducks-project/kirospectracker/issues"
  },
  "homepage": "https://github.com/ducks-project/kirospectracker#readme",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "kirospectracker.openDocument",
        "title": "%command.openDocument.title%"
      },
      {
        "command": "kirospectracker.refresh",
        "title": "%command.refresh.title%",
        "icon": "$(refresh)"
      },
      {
        "command": "kirospectracker.runTasks",
        "title": "%command.runTasks.title%"
      },
      {
        "command": "kirospectracker.toggleLayout",
        "title": "%command.toggleLayout.title%",
        "icon": "$(layout)"
      },
      {
        "command": "kirospectracker.tree.openRequirements",
        "title": "%command.tree.openRequirements.title%",
        "icon": "$(book)"
      },
      {
        "command": "kirospectracker.tree.openBugfix",
        "title": "%command.tree.openBugfix.title%",
        "icon": "$(bug)"
      },
      {
        "command": "kirospectracker.tree.openDesign",
        "title": "%command.tree.openDesign.title%",
        "icon": "$(symbol-structure)"
      },
      {
        "command": "kirospectracker.tree.openTasks",
        "title": "%command.tree.openTasks.title%",
        "icon": "$(checklist)"
      },
      {
        "command": "kirospectracker.tree.openNotes",
        "title": "%command.tree.openNotes.title%",
        "icon": "$(note)"
      },
      {
        "command": "kirospectracker.tree.syncFiles",
        "title": "%command.tree.syncFiles.title%",
        "icon": "$(sync)"
      },
      {
        "command": "kirospectracker.tree.runRequired",
        "title": "%command.tree.runRequired.title%",
        "icon": "$(play)"
      },
      {
        "command": "kirospectracker.tree.runRequiredAndOptional",
        "title": "%command.tree.runRequiredAndOptional.title%",
        "icon": "$(run-all)"
      },
      {
        "command": "kirospectracker.resetHiddenSpecs",
        "title": "%command.resetHiddenSpecs.title%"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "kirospectracker.openDocument",
          "when": "false"
        },
        {
          "command": "kirospectracker.tree.openRequirements",
          "when": "false"
        },
        {
          "command": "kirospectracker.tree.openBugfix",
          "when": "false"
        },
        {
          "command": "kirospectracker.tree.openDesign",
          "when": "false"
        },
        {
          "command": "kirospectracker.tree.openTasks",
          "when": "false"
        },
        {
          "command": "kirospectracker.tree.openNotes",
          "when": "false"
        },
        {
          "command": "kirospectracker.tree.syncFiles",
          "when": "false"
        },
        {
          "command": "kirospectracker.tree.runRequired",
          "when": "false"
        },
        {
          "command": "kirospectracker.tree.runRequiredAndOptional",
          "when": "false"
        }
      ],
      "explorer/context": [
        {
          "command": "kirospectracker.runTasks",
          "when": "explorerResourceIsFolder && resourcePath =~ /.*[\\\\/]\\.kiro[\\\\/]specs[\\\\/][^\\\\/]+$/",
          "group": "kirospectracker@1"
        }
      ],
      "view/title": [
        {
          "command": "kirospectracker.refresh",
          "when": "view == kirospectracker.dashboard",
          "group": "navigation"
        },
        {
          "command": "kirospectracker.toggleLayout",
          "when": "view == kirospectracker.dashboard",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "kirospectracker.tree.openRequirements",
          "when": "view == kirospectracker.tree && viewItem =~ /(^| )doc-requirements( |$)/",
          "group": "navigation@1"
        },
        {
          "command": "kirospectracker.tree.openDesign",
          "when": "view == kirospectracker.tree && viewItem =~ /(^| )doc-design( |$)/",
          "group": "navigation@2"
        },
        {
          "command": "kirospectracker.tree.openTasks",
          "when": "view == kirospectracker.tree && viewItem =~ /(^| )doc-tasks( |$)/",
          "group": "navigation@3"
        },
        {
          "command": "kirospectracker.tree.openNotes",
          "when": "view == kirospectracker.tree && viewItem =~ /(^| )doc-notes( |$)/",
          "group": "navigation@4"
        },
        {
          "command": "kirospectracker.tree.openBugfix",
          "when": "view == kirospectracker.tree && viewItem =~ /(^| )doc-bugfix( |$)/",
          "group": "navigation@5"
        },
        {
          "command": "kirospectracker.tree.syncFiles",
          "when": "view == kirospectracker.tree && viewItem =~ /(^| )agent-sync( |$)/",
          "group": "run@1"
        },
        {
          "command": "kirospectracker.tree.runRequired",
          "when": "view == kirospectracker.tree && viewItem =~ /(^| )agent-run-required( |$)/",
          "group": "run@2"
        },
        {
          "command": "kirospectracker.tree.runRequiredAndOptional",
          "when": "view == kirospectracker.tree && viewItem =~ /(^| )agent-run-optional( |$)/",
          "group": "run@3"
        }
      ]
    },
    "configuration": {
      "title": "Kiro Spec Tracker",
      "properties": {
        "kirospectracker.agentIntegration.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%setting.agentIntegration.enabled.markdownDescription%"
        },
        "kirospectracker.hideSpecs.mode": {
          "type": "string",
          "enum": [
            "off",
            "searchAndQuickOpen",
            "everywhere"
          ],
          "default": "off",
          "enumDescriptions": [
            "%setting.hideSpecs.mode.enumDescriptions.off%",
            "%setting.hideSpecs.mode.enumDescriptions.searchAndQuickOpen%",
            "%setting.hideSpecs.mode.enumDescriptions.everywhere%"
          ],
          "markdownDescription": "%setting.hideSpecs.mode.markdownDescription%"
        },
        "kirospectracker.hideSpecs.statuses": {
          "type": "object",
          "properties": {
            "Malformed": {
              "type": "boolean",
              "default": false,
              "description": "%setting.hideSpecs.statuses.Malformed.description%"
            },
            "NotStarted": {
              "type": "boolean",
              "default": false,
              "description": "%setting.hideSpecs.statuses.NotStarted.description%"
            },
            "InProgress": {
              "type": "boolean",
              "default": false,
              "description": "%setting.hideSpecs.statuses.InProgress.description%"
            },
            "Completed": {
              "type": "boolean",
              "default": true,
              "description": "%setting.hideSpecs.statuses.Completed.description%"
            },
            "FullyCompleted": {
              "type": "boolean",
              "default": true,
              "description": "%setting.hideSpecs.statuses.FullyCompleted.description%"
            }
          },
          "additionalProperties": false,
          "default": {
            "Malformed": false,
            "NotStarted": false,
            "InProgress": false,
            "Completed": true,
            "FullyCompleted": true
          },
          "markdownDescription": "%setting.hideSpecs.statuses.markdownDescription%"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "kirospectracker",
          "title": "Kiro Spec Tracker",
          "icon": "media/activitybar-icon.svg"
        }
      ]
    },
    "views": {
      "kirospectracker": [
        {
          "id": "kirospectracker.dashboard",
          "name": "%view.dashboard.name%",
          "type": "webview",
          "icon": "media/view-dashboard.svg"
        },
        {
          "id": "kirospectracker.tree",
          "name": "%view.tree.name%",
          "icon": "media/view-tree.svg"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc --noEmit && tsc --noEmit -p tsconfig.webview.json",
    "build": "node esbuild.mjs",
    "build:dev": "node esbuild.mjs --dev",
    "build:prod": "node esbuild.mjs --prod",
    "watch": "node esbuild.mjs --watch",
    "build:browser": "node esbuild.mjs --browser",
    "lint": "eslint --no-error-on-unmatched-pattern \"src/**/*.ts\" \"test/**/*.ts\" \"benchmark/**/*.ts\"",
    "format": "prettier --write \"**/*.{ts,mjs,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,mjs,json,md,yml,yaml}\"",
    "test:unit": "mocha",
    "test:property": "mocha --spec \"test/property/**/*.spec.ts\"",
    "coverage:core": "c8 --config .c8rc.json mocha",
    "coverage:adapters": "c8 --config .c8rc.adapters.json mocha",
    "coverage": "npm run coverage:core && npm run coverage:adapters",
    "test": "npm run coverage",
    "compile:test": "tsc -p tsconfig.test.json",
    "pretest:integration": "npm run compile:test",
    "test:integration": "node --loader ts-node/esm --no-warnings ./test/runTest.ts",
    "bench": "node --loader ts-node/esm --no-warnings ./benchmark/parse.bench.ts",
    "bench:update": "node --loader ts-node/esm --no-warnings ./benchmark/incremental-update.bench.ts",
    "package": "vsce package",
    "publish": "ovsx publish"
  },
  "overrides": {
    "glob": "14.0.4",
    "minimatch": "11.0.5"
  },
  "devDependencies": {
    "@types/chai": "5.0.1",
    "@types/mocha": "10.0.9",
    "@types/node": "20.17.6",
    "@types/vscode": "1.85.0",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "@vscode/test-electron": "2.4.1",
    "@vscode/vsce": "4.1.0",
    "c8": "12.0.0",
    "chai": "5.1.2",
    "esbuild": "0.28.2",
    "eslint": "8.57.1",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-import": "2.31.0",
    "fast-check": "3.23.1",
    "glob": "14.0.4",
    "lefthook": "1.8.2",
    "mitata": "1.0.20",
    "mocha": "12.0.3",
    "ovsx": "1.3.0",
    "prettier": "3.3.3",
    "ts-node": "10.9.2",
    "typescript": "5.6.3"
  },
  "l10n": "./l10n"
}
