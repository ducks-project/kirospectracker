# Dependencies
node_modules/

# Build output (esbuild) and TypeScript compilation artifacts
dist/
out/
*.tsbuildinfo

# Bundled webview assets emitted into media/ by esbuild (icon.png stays tracked)
media/dashboard.js
media/dashboard.css
media/*.map

# Test coverage
coverage/

# VS Code extension packaging and integration test runtime
*.vsix
.vscode-test/
.vscode-test-web/

# Linter cache
.eslintcache

# Local editor history
.history

# Kiro steering and specs.
# NOTE: .kiro stays ignored, except the four steering files referenced by CONTRIBUTING.md
# (typescript-conventions, vscode-extension-guidelines, testing-strategy, file-cohesion),
# which are tracked with `git add -f`.
.kiro

# Exception: integration-test fixtures ship their own throwaway .kiro/specs trees,
# which MUST be versioned so the @vscode/test-electron suite has them under CI.
!test/fixtures/**/.kiro
!test/fixtures/**/.kiro/**

# Agent task artifacts (scaffolding plan, FEAT descriptors, verdicts): never versioned.
.agents

# Local git worktrees used to develop a feature branch next to the main checkout.
.worktrees/

# VS Code multi-root workspace file
*.code-workspace
